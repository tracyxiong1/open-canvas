{
  "name": "@open-canvas/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "schema:generate": "node scripts/generate-schema.mjs",
    "build": "npm run schema:generate && tsc -p tsconfig.json",
    "check": "npm run schema:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run schema:generate && node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4"
  }
}
