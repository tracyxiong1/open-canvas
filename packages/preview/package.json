{
  "name": "@open-canvas/preview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @open-canvas/core",
    "dev": "vite",
    "prebuild": "npm run build --workspace @open-canvas/core",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "pretest": "npm run build --workspace @open-canvas/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sites": "npm run build && node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@open-canvas/core": "0.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "^12.11.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
